{
	"name": "@watergis/maplibre-gl-legend",
	"version": "4.2.1",
	"description": "This module adds legend control which is able to create legend panel from mapbox style to mapbox-gl-legend",
	"type": "module",
	"main": "dist/maplibre-gl-legend.es.js",
	"types": "./dist/types/index.d.ts",
	"module": "dist/maplibre-gl-legend.es.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/maplibre-gl-legend.es.js"
		},
		"./dist/maplibre-gl-legend.css": "./dist/maplibre-gl-legend.css",
		"./dist/maplibre-gl-legend.min.css": "./dist/maplibre-gl-legend.min.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"package.json"
	],
	"scripts": {
		"dev": "vite",
		"build": "npm run build:js",
		"build:js": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"keywords": [
		"mapbox",
		"mapbox-gl-js",
		"legend"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/watergis/maplibre-gl-legend.git"
	},
	"author": "Jin IGARASHI",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/watergis/maplibre-gl-legend/issues"
	},
	"homepage": "https://github.com/watergis/maplibre-gl-legend/tree/main/packages/maplibre-gl-legend#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@microsoft/api-extractor": "^7.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"@watergis/legend-ui": "workspace:^",
		"@watergis/maplibre2svg": "workspace:*",
		"@watergis/style-editor-ui": "workspace:^",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"globals": "^17.14.0",
		"lightningcss": "^1.33.0",
		"maplibre-gl": "^6.16.0",
		"path": "^0.12.7",
		"pmtiles": "^4.5.0",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"sass": "^1.107.1",
		"svelte": "^5.57.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-plugin-dts": "^5.1.2"
	},
	"peerDependencies": {
		"maplibre-gl": "^6.4.1"
	}
}
